.env
.venv/
__pycache__/
*.pyc
*.session
*.session-journal
output/
cache/
history/
.git/
*.log
# Generated by export_cache.py for reading locally -- nothing at runtime opens it, and it
# is far and away the biggest thing left in the upload once the caches above are gone.
export/
# Poll data lives on the volume at DATA_DIR, never in the image; a stray local copy would
# only be dead weight baked into a layer.
voting/
# A session string is a full login. It must never end up in an image layer, where it
# outlives the file itself (see generate_session_string.py, which writes one here).
*.session_string*
session_string_output.txt
