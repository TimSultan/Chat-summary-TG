# Get these from https://my.telegram.org/apps (log in, "API development tools", create an app)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Name of the local session file Telethon creates after your first interactive login.
# Keep it secret -- it grants full access to your Telegram account, like a saved login.
TELEGRAM_SESSION=tg_summary_session

# Alternative to TELEGRAM_SESSION, for hosts with no persistent disk (Railway, etc.):
# a portable session string instead of a file. Generate it locally with
# `python generate_session_string.py`, then set it as an env var on the host -- the
# deployed listener starts already logged in, no interactive step or volume needed.
# If set, this takes priority over TELEGRAM_SESSION. Leave blank for local use.
TELEGRAM_SESSION_STRING=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Any chat-capable model -- pick from the dropdown in gui.py, or set one directly here.
# gpt-4o / gpt-4o-mini are the old, slower tier; gpt-5.4-mini is the current fast/cheap
# default, gpt-5.5 is the best-quality flagship (similar latency to 5.4), gpt-5.4-nano is
# fastest/cheapest for quiet chats. See config.py's RECOMMENDED_MODELS for the full list.
OPENAI_MODEL=gpt-5.4-mini

# Model used for the small structured-JSON routing/classification calls (turning a
# request into a date range + optional target user, and matching a bare name against
# actual chat participants) -- separate from OPENAI_MODEL since these need little
# reasoning and have tiny input, so there's no reason to pay for the bigger model used
# for actual summary generation. Defaults to the cheapest tier regardless of what
# OPENAI_MODEL is set to.
OPENAI_ROUTING_MODEL=gpt-5.4-nano

# IANA timezone used for calendar-day boundaries and displayed/stored timestamps.
# This is deliberately explicit so a London-hosted deployment still runs on Moscow time.
APP_TIMEZONE=Europe/Moscow

# --- listener.py only (the mention-triggered auto-reply bot) ---

# Which /summary request pipeline the listener uses: "v2" (default) routes the request
# through intent_v2.py (date range + optional focus person + a cleaned-up question only)
# and answers it in one freeform step via responder_v2.py. "v1" uses the older
# intent.py/summarizer.py pipeline, which also extracts a separate topic/length hint and
# applies a larger rule-based prompt. Kept switchable for comparison/rollback. Only
# affects this account's own /summary handling -- bot_listener.py (below) always uses v2.
SUMMARY_PIPELINE_VERSION=v2

# Optional: run a separate bot account (bot_listener.py) that answers /summary as itself
# instead of your personal account, over Telegram's Bot HTTP API. Get a token from
# @BotFather (/newbot), then:
#   1. Message @BotFather -> /setprivacy -> select your bot -> Disable. "/summary" itself
#      arrives either way (Telegram always delivers slash-commands to bots regardless of
#      privacy mode), so this is for the OTHER features -- the stats counters and the
#      #япокрасил acknowledgements need to see ordinary chat messages.
#   2. Add the bot to each chat listed in LISTENER_ALLOWED_CHATS (it has no access to a
#      chat's history from before it joined, and no access at all to chats it isn't in).
#   3. Set TELEGRAM_BOT_TOKEN below and start listener.py as usual -- it detects the
#      token and runs bot_listener.py's long-polling loop alongside itself in the same
#      process, using this account's already-connected Telethon session (TELEGRAM_API_ID/
#      HASH/SESSION above) to fetch history, since bots can't fetch history themselves.
# Once set, this account's own /summary handling turns off automatically (to avoid two
# replies to the same message) -- save keeps working from this account as before.
# Leave blank to keep everything on this account only, as before.
TELEGRAM_BOT_TOKEN=

# The bot's own https:// address, used two ways: it's what /vote's "Открыть голосование"
# button opens as a Telegram Mini App (voting.py / vote_web.py), and it's what the bot's
# aiohttp server binds PORT under. Telegram refuses to open a Mini App over plain http or
# from a bare IP, so without this the /vote button is simply not offered. On Railway this
# is the domain shown under the service's Settings -> Networking (Railway sets PORT for
# you automatically once a domain is generated); locally, leave both this and PORT unset
# to run without the voting page at all.
WEBAPP_PUBLIC_URL=
PORT=

# Enables /poststats: a page showing per-post view/forward/reaction/comment stats for any
# chat/channel this account can see, over a chosen time range, as an interactive chart +
# table. Unlike /vote and /arena above, this is NOT a Telegram Mini App -- it's a plain
# page you open as a bookmarked link in an ordinary browser (yoursite.com/poststats?token=...),
# gated by this single shared-secret token instead of Telegram auth. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to keep the page unmounted entirely (the safe default -- there is no
# unauthenticated fallback if you forget to set this, the route simply doesn't exist).
# Requires PORT to be set too, same as /vote and /arena.
#
# This token can see EVERY chat this account is in -- do not hand it to anyone you don't
# want browsing your other chats too. To give someone read access to just their own
# group, use POST_STATS_SCOPED_TOKENS below instead.
POST_STATS_ACCESS_TOKEN=

# Optional. Extra tokens, each locked server-side to exactly ONE chat, for handing
# someone stats access to their own group without exposing anything else this account
# can see. A JSON object of "token": "chat_ref" pairs (chat_ref is whatever /poststats'
# chat field would normally accept: @username, numeric ID, or exact title) -- e.g.:
#   POST_STATS_SCOPED_TOKENS={"a-token-you-make-up":"@theirgroup","another-one":"-1001234567890"}
# Requires this account to already be a MEMBER of that chat -- joining it is a manual,
# one-time step (open Telegram, join the group) that no setting here can substitute for.
# Either this or POST_STATS_ACCESS_TOKEN (or both) mounts the page; leave both blank to
# keep it unmounted entirely.
POST_STATS_SCOPED_TOKENS=

# The second group "/vote chat" offers as a destination for its announcement, alongside
# the main chat from LISTENER_ALLOWED_CHATS -- after writing the text the admin picks
# "В чат", "В Папку художников", or "В оба", and each destination is posted to
# independently, so one failing never blocks the other. Telegram's sendMessage accepts an
# @username directly as the chat id, so this is the whole configuration needed: no numeric
# id, no lookup, just the bot being an admin (or at least a member able to post) there.
# A bare "papkahudojnicov" is accepted too and gets the @ added for you. Leave blank to
# drop the second destination entirely -- the announcement then only offers the main chat.
VOTE_ANNOUNCE_EXTRA_CHAT=@papkahudojnicov

# BotFather's Direct Link Mini App short name for this bot (@BotFather -> /newapp -> pick
# the bot -> the short name you choose there, with WEBAPP_PUBLIC_URL + /vote as its web
# app URL). It is what lets the vote button inside a GROUP open the Mini App in place, via
# https://t.me/<bot>/<short name>?startapp=vote -- Telegram allows a real web_app button
# only in a private chat and rejects one posted to a group, so a group post can only ever
# carry a plain link. Leave blank if you haven't created the app: the button then falls
# back to the https://t.me/<bot>?start=vote deep link, which lands the voter in the DM
# with the Mini App button waiting there, one extra tap away.
VOTE_MINIAPP_SHORT_NAME=

# Comma-separated allowlist of chats (by @username, exact title, or numeric ID) the listener
# will respond in. STRONGLY recommended: leaving this empty means the bot will respond to
# summary requests from anyone in any chat you're in, spending your OpenAI budget for them.
# bot_listener.py only: a private chat (DM) with the bot itself is ALWAYS allowed
# regardless of this list -- it's a legitimate input channel, not "any random chat". If
# this list contains exactly one entry, that chat also becomes the data source used for
# any /summary request that arrives via DM (a DM has no group history of its
# own to fetch, so it needs a fixed target to pull from) -- with zero or multiple entries
# there's no unambiguous default, and a DM request will just say so instead of guessing.
LISTENER_ALLOWED_CHATS=

# NOTE: LISTENER_TRIGGER_KEYWORDS no longer exists -- delete it if your deployment still
# has it set. Asking for a summary is "/summary" and nothing else: it has to be the FIRST
# thing in the message, exactly as a slash-command works. "/summary за вчера" asks for
# one; "я написал /summary а он молчит" does not, and neither does a bare word without
# its slash. "/summary@yourbot" (how Telegram spells a command in a group) is the same
# invocation.

# Every summary enquiry is retained in one FIFO queue. The first starts immediately;
# after each enquiry finishes, the worker waits this many seconds before starting next.
SUMMARY_QUEUE_DELAY_SECONDS=20

# Word that, when a message starting with it is sent by you as a reply to another
# message, reposts that replied-to message (photo, video, any media, or just text) to
# SAVE_CHANNEL below -- any text after the trigger word is appended as a caption. Your
# own trigger message gets a reaction and is then deleted a few seconds later. Unlike
# the summary trigger, this only ever fires for messages YOU send (never other
# chat members) and ignores LISTENER_ALLOWED_CHATS, since it doesn't touch the OpenAI
# budget.
SAVE_TRIGGER_KEYWORD=сохрани

# Channel (by @username, without the @) that SAVE_TRIGGER_KEYWORD reposts to. You must
# already be a member/admin of it. Leave blank to disable the save trigger.
SAVE_CHANNEL=papka_pokrasa

# On by default. Tracks per-user activity (messages, characters, media, replies, active
# days, hourly histogram -- see stats.py) once per calendar day, computed from the same
# per-day transcript cache everything else already uses -- no extra Telegram load beyond
# making sure that day's cache is complete before it closes out (see
# telegram_fetch.ensure_day_finalized). Needs a non-empty LISTENER_ALLOWED_CHATS --
# stats are tracked per named chat, there's no "everywhere" fallback.
#
# Powers two commands, in any allowed chat, from anyone (answered by the bot account --
# see TELEGRAM_BOT_TOKEN above):
#   /top day|week|month|year|all  -- top STATS_TOP_LIMIT people by a simple points score
#                             (+1/message, +1/photo-or-video message, +1/reply,
#                             +5/distinct active day, +150/message tagged #япокрасил with
#                             an actual photo attached -- always recomputed on demand,
#                             never stored, so tuning the point values later needs no
#                             backfill; "all" is the whole tracked history, not a rolling
#                             window; "day" is just an alias for "today")
#   /stat [username]       -- one person's all-time tracked totals, incl. raw figurines-
#                             painted count (yourself if no username is given); "/stat
#                             day|week|month|year|all" instead shows the same leaderboard
#                             as the equivalent /top
# Set to false to turn both commands and the daily tracking off.
STATS_ENABLED=true

# How many people /top (and /top-style /stat lookups) show.
STATS_TOP_LIMIT=10

# On startup (and, in effect, every midnight after), how many past days to check for
# unrecorded stats and back-fill -- covers downtime (a restart that missed one or more
# midnights) without re-scanning a chat's entire history every time. Already-recorded
# days within this window cost nothing but a file-existence check (see
# stats.is_recorded), so raising this is cheap UNLESS a chat has no transcript cache at
# all yet for some of those days, in which case each such day triggers a real Telegram
# history fetch.
STATS_CATCHUP_DAYS=7

# Optional. Where the transcript cache, Q&A history, per-day stats files, and voting polls
# + downloaded photos (cache/, history/, voting/) are written. Defaults to the current
# directory -- fine locally. On a host with no persistent disk by default (Railway, etc.),
# point this at a mounted Volume's path (e.g. /data) so those survive restarts/redeploys
# instead of resetting each time. Everything else tolerates that reset by re-fetching or
# starting empty; an open vote does not -- a redeploy mid-vote loses every ballot cast
# so far unless DATA_DIR is on a Volume. Strongly recommended if /vote is used at all.
DATA_DIR=
